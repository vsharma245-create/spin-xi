# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe in the browser: row level security permits select only.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# ── Advertising (optional) ────────────────────────────────────────────────
# Leave every line below unset and the site carries no advertising at all:
# nothing renders, no script is fetched, no ads.txt is written, and the privacy
# policy says so. Fill them in and the slots appear.
#
# The publisher id from AdSense — Account → Settings → Account information.
VITE_ADSENSE_CLIENT=
# Ad unit ids from AdSense → Ads → By ad unit. Any slot left blank stays empty.
VITE_AD_SLOT_RESULT=
VITE_AD_SLOT_HOME=
VITE_AD_SLOT_LEADERBOARD=
