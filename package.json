{
  "name": "spin-xi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-facts.mjs && tsc -b && vite build && node scripts/render-pages.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=spin-xi --branch=production",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "node scripts/generate-seed.mjs",
    "db:push": "node scripts/db-push.mjs",
    "ingest": "node scripts/ingest-cricsheet.mjs",
    "archive": "node scripts/build-archive.mjs",
    "rerate": "node scripts/rerate.mjs",
    "data:check": "esbuild scripts/data-probe.ts --bundle --platform=node --format=esm --outfile=.data-probe.mjs --external:@electric-sql/pglite --log-level=error && node .data-probe.mjs; rm -f .data-probe.mjs",
    "challenges": "node scripts/build-challenges.mjs",
    "nations": "node scripts/fetch-nations.mjs",
    "bowling": "node scripts/fetch-bowling.mjs",
    "roles": "node scripts/fetch-roles.mjs",
    "db:check": "node scripts/db-check.mjs",
    "live:check": "esbuild scripts/live-probe.ts --bundle --platform=node --format=esm --outfile=.live-probe.mjs --external:@electric-sql/pglite --log-level=error && node .live-probe.mjs; rm -f .live-probe.mjs",
    "cards:check": "esbuild scripts/card-probe.ts --bundle --platform=node --format=esm --outfile=.card-probe.mjs --external:@electric-sql/pglite --log-level=error && node .card-probe.mjs; rm -f .card-probe.mjs",
    "combos:check": "esbuild scripts/combo-probe.ts --bundle --platform=node --format=esm --outfile=.combo-probe.mjs --external:@electric-sql/pglite --log-level=error && node .combo-probe.mjs; rm -f .combo-probe.mjs",
    "draft:check": "esbuild scripts/draft-probe.ts --bundle --platform=node --format=esm --outfile=.draft-probe.mjs --external:@electric-sql/pglite --log-level=error && node .draft-probe.mjs; rm -f .draft-probe.mjs",
    "live:prod": "esbuild scripts/two-client-probe.ts --bundle --platform=node --format=esm --outfile=.two-client.mjs --external:@electric-sql/pglite --log-level=error && node .two-client.mjs; rm -f .two-client.mjs",
    "audit": "node scripts/audit.mjs",
    "rows:check": "esbuild scripts/row-probe.ts --bundle --platform=node --format=esm --outfile=.row-probe.mjs --external:@electric-sql/pglite --log-level=error && node .row-probe.mjs; rm -f .row-probe.mjs",
    "play:check": "esbuild scripts/playback-probe.ts --bundle --platform=node --format=esm --outfile=.play-probe.mjs --external:@electric-sql/pglite --log-level=error && node .play-probe.mjs; rm -f .play-probe.mjs",
    "engine:check": "esbuild scripts/engine-probe.ts --bundle --platform=node --format=esm --outfile=.engine.mjs --external:@electric-sql/pglite --log-level=error && node .engine.mjs; rm -f .engine.mjs",
    "facts": "node scripts/build-facts.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.125.0"
  }
}
